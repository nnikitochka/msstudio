<!-- Kept by hand for this community-only fork: the ultimate generator is the only writer of this file in a
     monorepo checkout, and a community-only checkout has no ultimate generator. The content mirrors the file
     the generator writes for 'Idea', because MSStudio includes the same base fragment.
     Source: org.jetbrains.intellij.build.MSStudioProperties.getProductContentDescriptor() -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <id>com.intellij</id>
  <name>IDEA CORE</name>
  <module value="com.intellij.modules.all"/>
  <module value="com.intellij.modules.idea"/>
  <module value="com.intellij.modules.idea.community"/>
  <module value="com.intellij.modules.java-capable"/>
  <module value="com.intellij.modules.lang"/>
  <module value="com.intellij.modules.lang.actions"/>
  <module value="com.intellij.modules.platform"/>
  <module value="com.intellij.modules.python-core-capable"/>
  <module value="com.intellij.modules.python-in-non-pycharm-ide-capable"/>
  <module value="com.intellij.platform.ide.provisioner"/>

  <xi:include href="/META-INF/DesignerCorePlugin.xml">
    <xi:fallback/>
  </xi:include>
  <xi:include href="/META-INF/intellij.moduleSets.ide.common.xml"/>
  <xi:include href="/META-INF/intellij.moduleSets.compose.runtime.xml"/>
  <xi:include href="/META-INF/intellij.moduleSets.platform.resources.defaults.xml"/>
  <xi:include href="/META-INF/intellij.moduleSets.rd.common.xml"/>
  <!-- region additional -->
  <content namespace="jetbrains">
    <module name="intellij.platform.remoteServers.impl"/>
    <module name="intellij.java.ide.resources" loading="required"/>
    <module name="intellij.java.ide.newUiOnboarding"/>
    <module name="intellij.platform.coverage"/>
    <module name="intellij.platform.coverage.agent"/>
    <module name="intellij.xml.xmlbeans"/>
    <module name="intellij.libraries.log4j.to.slf4j"/>
    <module name="intellij.libraries.xmlbeans"/>
    <module name="intellij.platform.ide.newUiOnboarding"/>
    <module name="intellij.platform.ide.newUsersOnboarding"/>
    <module name="intellij.ide.startup.importSettings"/>
    <module name="intellij.platform.customization.min"/>
    <module name="intellij.idea.community.ide.customization" loading="embedded"/>
    <module name="intellij.msstudio.ide.customization" loading="embedded"/>
  </content>
  <content>
    <module name="intellij.libraries.sqlite"/>
  </content>
  <!-- endregion -->
</idea-plugin>